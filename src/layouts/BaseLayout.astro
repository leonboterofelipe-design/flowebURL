---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/main.css';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFloat from '@/components/layout/WhatsAppFloat.astro';
import StickyCta from '@/components/layout/StickyCta.astro';
import Analytics from '@/components/layout/Analytics.astro';
import { site } from '@/config/site';
import { gtmId } from '@/config/analytics';
import { pages } from '@/data/pages';
import { organizationSchema, breadcrumbSchema } from '@/lib/schema';

interface Props { title: string; description?: string; noindex?: boolean; schema?: object[] }
const { title, description = site.description, noindex = false, schema = [] } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const current = Object.values(pages).find((p) => p.path === path);
const graph = [
  ...(path === '/' ? [organizationSchema()] : []),
  ...(current && path !== '/' ? [breadcrumbSchema(current.name, path)] : []),
  ...schema,
];
const gsc = import.meta.env.PUBLIC_GSC_TOKEN;
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#05070F" />
    {noindex && <meta name="robots" content="noindex" />}
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={new URL(site.ogImage, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FloWeb, agencia Shopify Partner en Colombia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
    <Analytics />
  </head>
  <body>
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <WhatsAppFloat />
    <Navbar />
    <main id="contenido"><slot /></main>
    <Footer />
    <StickyCta />
  </body>
</html>
