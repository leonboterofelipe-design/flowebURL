---
import { pages } from '@/data/pages';
import { site } from '@/config/site';
import { waLink } from '@/lib/whatsapp';
import Takeaways from '@/components/sections/Takeaways.astro';
interface Props { page: string }
const m = pages[Astro.props.page];
const url = new URL(m.path, site.url).href;
const text = encodeURIComponent(`${m.title} ${url}`);
---
<section class="page-hero">
  <div class="container">
    <h1>{m.h1}</h1>
    <p class="lead">{m.lead}</p>
    <a class="btn btn-shopify" href={waLink(Astro.url.pathname)} target="_blank" rel="noopener noreferrer">Pedir diagnóstico gratis</a>
    <Takeaways items={m.takeaways} />
    <p class="share">
      Compartir:
      <a href={`https://wa.me/?text=${text}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </p>
  </div>
</section>
