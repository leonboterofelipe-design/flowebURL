---
import { gtmId } from '@/config/analytics';
const gaId = import.meta.env.PUBLIC_GA4_ID;
---
{gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', gtmId);
  </script>
)}
{!gtmId && gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
{!gtmId && gaId && (
  <script is:inline define:vars={{ gaId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', gaId);
  </script>
)}
{(gtmId || gaId) && (
  <script is:inline define:vars={{ viaGtm: !!gtmId }}>
    // Lead = clic en WhatsApp o email. Con GTM llega como evento "generate_lead" al dataLayer
    // (crea en GTM un activador de evento personalizado con ese nombre y una etiqueta de evento GA4).
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href*="wa.link"], a[href*="wa.me"], a[href^="mailto:"]');
      if (!a || a.closest('.share')) return;
      var params = { method: a.href.indexOf('mailto:') === 0 ? 'email' : 'whatsapp', link_url: a.href };
      if (viaGtm) window.dataLayer.push(Object.assign({ event: 'generate_lead' }, params));
      else gtag('event', 'generate_lead', params);
    });
  </script>
)}
