---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pages } from '@/data/pages';
import CtaFinal from '@/components/sections/CtaFinal.astro';
import Faq from '@/components/sections/Faq.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Problem from '@/components/sections/Problem.astro';
import RelatedLinks from '@/components/sections/RelatedLinks.astro';
import ShopifyIntro from '@/components/sections/ShopifyIntro.astro';
import { faqsShopify } from '@/data/faqs';
const m = pages.shopify;
---
<BaseLayout title={m.title} description={m.description}>
  <PageHero page="shopify" />
  <ShopifyIntro />
  <Problem />
  <Faq items={faqsShopify} />
  <RelatedLinks current="shopify" />
  <CtaFinal />
</BaseLayout>
